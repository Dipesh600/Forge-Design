<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="200"
    android:viewportHeight="200">
    
    <!-- Luminous Radial Glow Background -->
    <path
        android:pathData="M100,100m-80,0a80,80 0,1 1,160 0a80,80 0,1 1,-160 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="80"
                android:type="radial">
                <item android:color="#267B6AF7" android:offset="0" />
                <item android:color="#007B6AF7" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Deep Shadow Layer (for 3D depth) -->
    <path
        android:fillColor="#40000000"
        android:pathData="M67,57 L137,57 L137,77 L87,77 L87,102 L127,102 L127,122 L87,122 L87,157 L67,157 Z" />

    <!-- Main "F" Glyph -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M65,55 L135,55 L135,75 L85,75 L85,100 L125,100 L125,120 L85,120 L85,155 L65,155 Z" />
        
    <!-- Bevel Highlight (Top/Left edges) -->
    <path
        android:fillColor="#40FFFFFF"
        android:pathData="M65,55 L135,55 L135,56 L66,56 L66,155 L65,155 Z" />

    <!-- Luminous Accent Bar (Vibrant Depth) -->
    <path
        android:pathData="M120,100 L130,100 L130,120 L120,120 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="120"
                android:startY="110"
                android:endX="130"
                android:endY="110"
                android:type="linear">
                <item android:color="#A294F9" android:offset="0" />
                <item android:color="#7B6AF7" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Sparkle -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M135,55 L137,53 L135,51 L133,53 Z" />

</vector>
