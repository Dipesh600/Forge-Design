<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:animateLayoutChanges="true"
    android:paddingStart="12dp"
    android:paddingEnd="48dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Activity Header (Clickable) -->
    <LinearLayout
        android:id="@+id/llActivityHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_thinking_header"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/viewActivityOrb"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_thinking_orb" />

        <TextView
            android:id="@+id/tvActivityTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Action Log"
            android:textColor="#E8E8F0"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.01" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AGENT"
            android:textSize="8sp"
            android:textColor="#A294F9"
            android:background="@drawable/bg_glass_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <ImageView
            android:id="@+id/ivActivityChevron"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/arrow_down_float"
            android:tint="#6B6B8A" />
    </LinearLayout>

    <!-- Collapsible Content -->
    <TextView
        android:id="@+id/tvActivityContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="4dp"
        android:padding="12dp"
        android:background="@drawable/bg_thinking_content"
        android:textColor="#8B8B9A"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:visibility="gone" />

</LinearLayout>
