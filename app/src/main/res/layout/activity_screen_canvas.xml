<?xml version="1.0" encoding="utf-8"?>
<!--
    FORGE Canvas — clean multi-screen viewer
    Layout: Loading state OR screen grid, with a slim status bar and fullscreen viewer
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/canvasRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F">

    <!-- Top bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0A0A0F"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="#FFFFFF"
            app:titleTextColor="#FFFFFF"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
            tools:title="FORGE Canvas" />

        <!-- Slim progress bar shown during generation -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:visibility="gone"
            app:indicatorColor="#7C4DFF"
            app:trackColor="#1A1A2E" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- ── LOADING state ── -->
        <LinearLayout
            android:id="@+id/loadingState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="visible">

                <View
                android:id="@+id/shimmerLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="16dp">

                    <!-- Shimmer screen 1 -->
                    <View
                        android:layout_width="140dp"
                        android:layout_height="240dp"
                        android:layout_margin="8dp"
                        android:background="#1E1E2E"
                        android:alpha="0.6" />

                    <!-- Shimmer screen 2 -->
                    <View
                        android:layout_width="140dp"
                        android:layout_height="240dp"
                        android:layout_margin="8dp"
                        android:background="#1E1E2E"
                        android:alpha="0.4" />

                </LinearLayout>
                </View>

            <TextView
                android:id="@+id/tvGeneratingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:textColor="#9E9EA8"
                android:textSize="14sp"
                android:text="FORGE is generating your screens…"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/tvGeneratingDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="#5A5A6A"
                android:textSize="12sp"
                android:text="This takes 60–90 seconds" />

        </LinearLayout>

        <!-- ── SUCCESS state — screen grid ── -->
        <LinearLayout
            android:id="@+id/successState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Project name + screen count -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvProjectName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="PulseFit" />

                <TextView
                    android:id="@+id/tvScreenCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#7C4DFF"
                    android:textSize="13sp"
                    tools:text="3 screens" />

            </LinearLayout>

            <!-- Horizontal scrollable screen thumbnails -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvScreens"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Bottom action strip — minimal, just regenerate -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="#0D0D1A"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegenerate"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Regenerate"
                    android:textColor="#7C4DFF"
                    app:strokeColor="#7C4DFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExploreVariants"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Variants"
                    android:textColor="#FF4081"
                    app:strokeColor="#FF4081" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenInStitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open in Stitch"
                    android:backgroundTint="#7C4DFF"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── ERROR state ── -->
        <LinearLayout
            android:id="@+id/errorState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✗"
                android:textSize="40sp"
                android:textColor="#FF4444"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#9E9EA8"
                android:textSize="14sp"
                tools:text="Failed to generate screens." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Try Again"
                android:backgroundTint="#7C4DFF" />

        </LinearLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
