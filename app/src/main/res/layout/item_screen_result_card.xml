<?xml version="1.0" encoding="utf-8"?>
<!--
  item_screen_result_card.xml
  Screen result generated inline in chat by the real FORGE agent.
  Shows: screen name label, full screenshot thumbnail, tap to preview.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screenCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="48dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- FORGE label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✦ FORGE"
        android:textSize="10sp"
        android:letterSpacing="0.08"
        android:textColor="#7B68EE"
        android:paddingBottom="4dp"
        android:fontFamily="sans-serif-medium" />

    <!-- Card container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardScreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#1E1B2E"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Screen thumbnail image -->
            <ImageView
                android:id="@+id/imgScreenshot"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:scaleType="centerCrop"
                android:background="#2A2540"
                tools:src="@color/purple_500" />

            <!-- Bottom bar: name + view button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvScreenName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        tools:text="Home Dashboard" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to preview"
                        android:textColor="#7B7B99"
                        android:textSize="11sp"
                        android:paddingTop="2dp" />

                </LinearLayout>

                <!-- Preview icon button -->
                <TextView
                    android:id="@+id/btnPreview"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="↗"
                    android:textColor="#7B68EE"
                    android:textSize="18sp"
                    android:background="@drawable/bg_preview_btn"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
