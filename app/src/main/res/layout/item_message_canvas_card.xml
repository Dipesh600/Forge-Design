<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/canvasCard"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="64dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:transitionName="canvas_handoff"
    app:cardCornerRadius="24dp"
    app:cardBackgroundColor="#1C1C26"
    app:cardElevation="8dp"
    app:strokeColor="#33FFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:minWidth="280dp">

        <!-- FORGE badge row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✦"
                android:textColor="@color/forge_primary"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FORGE CANVAS"
                android:textColor="@color/forge_primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1"
                android:textAllCaps="true" />

        </LinearLayout>

        <!-- Project name — large, prominent -->
        <TextView
            android:id="@+id/tvProjectName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="6dp"
            android:text="FORGE Project" />

        <!-- Screens list — compact, single line -->
        <TextView
            android:id="@+id/tvScreensList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A0A0B5"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="16dp"
            android:text="Home · Profile · Settings" />

        <!-- Mood + screenCount chip row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvCanvasPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/forge_primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black"
                android:text="minimal" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Open in Canvas CTA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenCanvas"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Open in Studio →"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-black"
            android:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="14dp"
            android:background="@drawable/bg_button_premium"
            app:backgroundTint="@null" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
