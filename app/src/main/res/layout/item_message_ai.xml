<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingStart="12dp">

    <!-- FORGE agent label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✦ FORGE"
        android:textSize="10sp"
        android:textColor="#6B6B8A"
        android:layout_marginBottom="4dp"
        android:letterSpacing="0.08" />

    <!-- Message bubble with streaming cursor -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_ai_bubble"
        android:maxWidth="280dp">

        <TextView
            android:id="@+id/messageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:paddingEnd="4dp"
            android:text="AI message"
            android:textColor="#E8E8F0"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp" />

        <!-- Blinking cursor ▌ — visible only while streaming -->
        <TextView
            android:id="@+id/tvStreamingCursor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▌"
            android:textColor="#7C6AF7"
            android:textSize="15sp"
            android:paddingEnd="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Actions (Copy, Retry) -->
    <LinearLayout
        android:id="@+id/aiActionsGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        android:layout_marginStart="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnCopy"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_copy"
            app:tint="#6B6B8A"
            android:padding="6dp"
            android:contentDescription="Copy response" />

        <ImageButton
            android:id="@+id/btnRetry"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_refresh"
            app:tint="#6B6B8A"
            android:padding="6dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Retry prompt" />
    </LinearLayout>

</LinearLayout>

