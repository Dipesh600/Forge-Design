<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingStart="12dp">

    <!-- FORGE agent label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✦ FORGE"
        android:textSize="10sp"
        android:textColor="@color/forge_primary"
        android:fontFamily="sans-serif-black"
        android:layout_marginBottom="6dp"
        android:letterSpacing="0.1"
        android:textAllCaps="true" />

    <!-- Message bubble with streaming cursor -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_ai_bubble"
        android:maxWidth="300dp">

        <TextView
            android:id="@+id/messageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:text="AI message"
            android:textColor="#E8E8F0"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="3dp" />

        <!-- Blinking cursor ▌ — visible only while streaming -->
        <TextView
            android:id="@+id/tvStreamingCursor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▌"
            android:textColor="#7C6AF7"
            android:textSize="15sp"
            android:paddingEnd="12dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Actions (Copy, Retry) -->
    <LinearLayout
        android:id="@+id/aiActionsGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginStart="4dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/btnCopy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_copy"
                app:tint="#A0A0B0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COPY"
                android:textColor="#A0A0B0"
                android:textSize="10sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginStart="6dp"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_glass_card"
            android:layout_marginStart="10dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_refresh"
                app:tint="#A0A0B0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RETRY"
                android:textColor="#A0A0B0"
                android:textSize="10sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginStart="6dp"
                android:letterSpacing="0.08" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

