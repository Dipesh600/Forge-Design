<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ForgeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Forge">
        <!-- Auth screen — launcher entry point -->
        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Forge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main unified ChatGPT-style interface -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Forge" />

        <!-- FORGE Design Canvas — screen generation output -->
        <activity
            android:name=".ui.canvas.ScreenCanvasActivity"
            android:exported="false"
            android:theme="@style/Theme.Forge" />

        <!-- FORGE Screen Preview — in-app full screen WebView viewer -->
        <activity
            android:name=".ui.canvas.ScreenPreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.Forge" />
    </application>

</manifest>